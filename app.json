{
  "expo": {
    "name": "Device Tools",
    "slug": "device-tools",
    "version": "1.0.1",
    "orientation": "default",
    "scheme": "devicetools",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nehuenparrondo.devicetools",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Permití verificar tu identidad y proteger el historial.",
        "NSMotionUsageDescription": "Device Tools usa sensores de movimiento y pasos cuando activás la herramienta."
      }
    },
    "android": {
      "package": "com.nehuenparrondo.devicetools",
      "allowBackup": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.VIBRATE",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.WRITE_SETTINGS",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#181E1B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Permití usar la cámara para fotos y códigos.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permití obtener tu ubicación al usar GPS."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permití verificar tu identidad y proteger el historial."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permití seleccionar una foto de la galería.",
          "cameraPermission": "Permití usar la cámara para fotos y códigos.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Permití acceder a las fotografías seleccionadas.",
          "savePhotosPermission": "Permití guardar una foto en tu galería.",
          "granularPermissions": ["photo"]
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Permití consultar movimiento y pasos cuando activás los sensores."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "backgroundColor": "#181E1B"
        }
      ],
      "expo-sqlite"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0241fee7-3bb9-4aff-be17-68aa6229278b"
      }
    },
    "owner": "elpepoestangod"
  }
}
