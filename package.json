{
  "name": "device-tools",
  "version": "1.0.1",
  "type": "module",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.28",
    "expo-battery": "~57.0.3",
    "expo-brightness": "~57.0.2",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.12",
    "expo-local-authentication": "~57.0.3",
    "expo-location": "~57.0.21",
    "expo-media-library": "~57.0.5",
    "expo-network": "~57.0.2",
    "expo-router": "~57.0.26",
    "expo-sensors": "~57.0.3",
    "expo-speech": "~57.0.3",
    "expo-splash-screen": "~57.0.10",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@types/node": "^24.19.1",
    "@types/react": "~19.2.2",
    "eslint": "^10.12.0",
    "eslint-config-expo": "^57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "expo-doctor": "^1.20.4",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --go",
    "start:dev": "expo start --dev-client",
    "android": "expo start --android --go",
    "ios": "expo start --ios --go",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "doctor": "expo-doctor",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "build:apk": "npx eas-cli@latest build -p android --profile preview",
    "build:development": "npx eas-cli@latest build -p android --profile development",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && expo install --check && expo-doctor"
  },
  "private": true
}
